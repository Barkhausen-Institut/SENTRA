[package]
name = "Sentra-Attester"
version = "0.1.0"
edition = "2021"

[dependencies]
getrandom="=0.3.4"
prost = "=0.12.3"
prost-derive="=0.12.3"
prost-types="=0.12.3"

occlum-sgx = "=0.1.13"
log="=0.4.28"
#axum = "=0.7.7"
tokio = { version = "=1.38.1",features = ["rt-multi-thread"] }
indexmap="=2.11.0"
syn = "=2.0.106"
serde="=1.0.228"
quote="=1.0.40"
#parking_lot="=0.12.4"
proc-macro2="=1.0.103"
ryu="=1.0.20"
#parking_lot_core="=0.9.11"
unicode-ident="=1.0.22"
tokio-util="=0.7.11"
tokio-stream="=0.1.15"
#lock_api="=0.4.13"
itoa="=1.0.15"

anyhow="=1.0.100"
socket2="=0.5.10"
tonic = { version = "=0.11.0", default-features = false, features = ["channel","tls","codegen","prost"] }
hostname="=0.3.1"

rustls = { version = "=0.23.17", features = ["aws_lc_rs"] }
aws-lc-rs="=1.13.3"
#aws-lc-rs="=1.16.0"
serde_json="=1.0.145"
hyper-rustls="=0.27.2"
tokio-rustls="=0.26.0"
rcgen="=0.13.2"
time-core="=0.1.1"
time="=0.3.23"
#rustls-pki-types="=1.14.0"
rustls-pemfile="=2.2.0"
hyper-util="=0.1.20"
#reqwest="=0.12.28"
#reqwest = { version = "0.12.28", default-features = false, features = ["rustls-tls"] }
#icu_provider="=1.2.0"
#icu_normalizer_data="=1.3.0"
#icu_properties_data="=1.3.0"
#zerovec="=0.8.1"
litemap="=0.7.1"
#openssl-sys="=0.9.109"
#idna_adapter="=1.1.0"
#tinystr="=0.7.4"
#native-tls="=0.2.13"
writeable="=0.5.3"
#zerofrom="=0.1.3"
#yoke="=0.7.2"
futures-util="=0.3.31"
futures-channel="=0.3.31"
futures-task="=0.3.31"
schannel="=0.1.27"

instant-acme = { git = "https://github.com/sk13/instant-acme.git", rev = "ac84bb585040133195624367f9c572b70c589593",  default-features = false,features = ["aws-lc-rs","hyper-rustls"]}

argh="=0.1.12"
argh_shared="=0.1.12"
rustc_version_runtime = "=0.3.0"

[build-dependencies]
tonic-build = "=0.11.0"
getrandom="=0.3.4"
home="=0.5.5"

[[bin]]
name = "sentra_attester"
path ="src/main.rs"

