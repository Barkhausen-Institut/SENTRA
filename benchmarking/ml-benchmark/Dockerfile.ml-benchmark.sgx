# Packaged Occlum / SGX ML benchmark image.
# Build from repository root:
#   docker build -f benchmarking/sentra-node/Dockerfile.sentra-node-sgx -t <tag> .
#---------------------------------------------------------------------
ARG BASE_IMAGE=occlum/occlum:0.31.0-ubuntu22.04
ARG BASE_IMAGE_RT=occlum/occlum:0.31.0-rt-ubuntu22.04
FROM $BASE_IMAGE AS sentra-builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin
ENV IS_DOCKERFILE=1

WORKDIR /

RUN apt-get update && apt-get install -y jq

RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh
RUN bash ./Miniconda3-latest-Linux-x86_64.sh -b -p /miniconda
RUN /miniconda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
RUN /miniconda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
RUN /miniconda/bin/conda create --prefix /python-occlum -y  python==3.10.0 numpy==1.26.4 pyyaml==6.0.3 tensorflow==2.11.0

COPY ./benchmarking/ml-benchmark/sentra-benchmark-sbom.yaml /
COPY ./benchmarking/shared/mnist.npz /root/.keras/datasets/mnist.npz
COPY ./benchmarking/shared/mnist.npz /mnist.npz

RUN mkdir -p /workspace/node /workspace/client
COPY sentra-node/python/node/ /workspace/node/
COPY sentra-node/python/client/ /workspace/client/

COPY benchmarking/ml-benchmark/run_benchmark_from_config.py /usr/local/bin/run_benchmark_from_config.py
COPY benchmarking/ml-benchmark/configs/ /workspace/benchmark-configs/
COPY benchmarking/ml-benchmark/entrypoint-ml-benchmark.sh /entrypoint.sh
COPY benchmarking/ml-benchmark/enclave_run_script_ml_benchmark.sh /bin/enclave_run_script.sh
RUN chmod +x /usr/local/bin/run_benchmark_from_config.py /entrypoint.sh /bin/enclave_run_script.sh \
    && sed -i 's/\r$//' /entrypoint.sh /bin/enclave_run_script.sh /usr/local/bin/run_benchmark_from_config.py

RUN occlum new /occlum-instance
RUN rm -rf /occlum-instance/image
WORKDIR /occlum-instance

RUN mkdir -p ./image
RUN copy_bom -f /sentra-benchmark-sbom.yaml --root image --include-dir /opt/occlum/etc/template

RUN new_json="$(jq '.metadata.debuggable=false \
    |.feature.enable_edmm=true \
    |.resource_limits.user_space_size = "1MB" \
    |.resource_limits.user_space_max_size = "32000MB" \
    |.resource_limits.kernel_space_heap_size = "1MB" \
    |.resource_limits.kernel_space_heap_max_size = "512MB" \
    |.resource_limits.max_num_of_threads = 64 \
    |.mount +=[{"target":"/workspace/node/logs","type":"hostfs","source":"/workspace/node/logs"}] \
    |.env.default += ["PYTHONHOME=/opt/python-occlum", "OMP_NUM_THREADS=1", "OPENBLAS_NUM_THREADS=1", "MKL_NUM_THREADS=1", "NUMEXPR_NUM_THREADS=1", "SENTRA_PREWARM_TRAIN_UNPACK=1", "SENTRA_BARRIER_RESEND_S=2", "SENTRA_STRICT_UNPACK_BARRIER=1", "PATH=/opt/python-occlum/bin:/bin:/usr/bin"]' Occlum.json)" \
    && echo "${new_json}" > Occlum.json



RUN ENABLE_EDMM=Y occlum build
RUN occlum package --debug occlum-instance.tar.gz

FROM $BASE_IMAGE_RT AS sentra
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin

RUN echo 'deb [arch=amd64] https://download.01.org/intel-sgx/sgx_repo/ubuntu jammy main' | tee /etc/apt/sources.list.d/intel-sgx.list

RUN apt-get update && apt-get install -y \
sgx-aesm-service=2.21.100.1-jammy1

COPY --from=sentra-builder /entrypoint.sh /

COPY --from=sentra-builder /occlum-instance/occlum-instance.tar.gz /

WORKDIR /
RUN tar -xf occlum-instance.tar.gz
RUN rm occlum-instance.tar.gz

WORKDIR /occlum-instance
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
