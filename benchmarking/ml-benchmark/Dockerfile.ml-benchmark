# ML benchmark image (plain Ubuntu; full node + client; YAML or raw .py entry).
# Non-SGX numerics should match native WSL (not the Occlum dev image).
# Build from repository root:
#   docker build -f benchmarking/ml-benchmark/Dockerfile.ml-benchmark -t sentra-ml-benchmark:latest .
#---------------------------------------------------------------------
ARG BASE_IMAGE=ubuntu:22.04
FROM $BASE_IMAGE AS sentra-ml-benchmark

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    IS_DOCKERFILE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    PYTHONPATH=/workspace/node:/workspace/client

WORKDIR /

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates jq wget \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
    && bash ./Miniconda3-latest-Linux-x86_64.sh -b -p /miniconda \
    && rm -f Miniconda3-latest-Linux-x86_64.sh
RUN /miniconda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main \
    && /miniconda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
RUN /miniconda/bin/conda create --prefix /python-occlum -y python=3.10.0 numpy==1.26.4 pyyaml==6.0.3 tensorflow==2.11.0 psutil

RUN mkdir -p /workspace/node /workspace/client
COPY sentra-node/python/node/ /workspace/node/
COPY sentra-node/python/client/ /workspace/client/

COPY benchmarking/ml-benchmark/run_benchmark_from_config.py /usr/local/bin/run_benchmark_from_config.py
COPY benchmarking/ml-benchmark/collect_run_metrics.py /usr/local/bin/collect_run_metrics.py
COPY benchmarking/ml-benchmark/scripts/compare_versioning_overhead.py /usr/local/bin/compare_versioning_overhead.py
COPY benchmarking/ml-benchmark/configs/ /workspace/benchmark-configs/
COPY benchmarking/ml-benchmark/entrypoint-ml-benchmark.sh /entrypoint.sh
COPY benchmarking/ml-benchmark/enclave_run_script_ml_benchmark.sh /bin/enclave_run_script.sh

COPY ./benchmarking/shared/mnist.npz /root/.keras/datasets/mnist.npz
COPY ./benchmarking/shared/mnist.npz /mnist.npz

RUN chmod +x /usr/local/bin/run_benchmark_from_config.py /usr/local/bin/collect_run_metrics.py /usr/local/bin/compare_versioning_overhead.py /entrypoint.sh /bin/enclave_run_script.sh \
    && sed -i 's/\r$//' /entrypoint.sh /bin/enclave_run_script.sh /usr/local/bin/run_benchmark_from_config.py /usr/local/bin/collect_run_metrics.py /usr/local/bin/compare_versioning_overhead.py

WORKDIR /workspace/node
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
CMD ["--config", "/workspace/benchmark-configs/quick.yaml"]
